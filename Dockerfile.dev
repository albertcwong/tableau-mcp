FROM --platform=linux/amd64 node:22-bookworm-slim
WORKDIR /app
RUN npm install -g tsx
# Python + uv for createHyperFromRecords (tableauhyperapi needs glibc; Alpine/musl incompatible)
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
  && pip install --break-system-packages uv && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY mcp-app ./mcp-app
RUN npm run build:mcp-app && cp -r build/mcp-app /opt/mcp-app-prebuilt
# src/, build/, mcp-app/ volume-mounted at runtime
COPY scripts/ /app/scripts/
RUN chmod +x /app/scripts/dev-docker.sh && cd /app/scripts && uv sync
CMD ["sh", "/app/scripts/dev-docker.sh"]
